# Zona horaria para el cron (node-cron respeta esta variable).
TZ=America/Santiago

# Expresión cron (default: 10:00 todos los días, hora Santiago).
# Ejemplos:
#   "0 10 * * *"     -> 10:00 AM cada día
#   "30 8 * * *"     -> 8:30 AM cada día
#   "0 10 * * 1-5"   -> 10:00 AM de lunes a viernes
CRON_SCHEDULE=0 9 * * *

# Archivo con destinatarios (array JSON de IDs).
RECIPIENTS_FILE=recipients.json

# Carpeta donde el scraper Python escribe los JSON diarios.
DATA_DIR=data

# Voz de edge-tts para el audio del día.
# Default: Lorenzo, masculino chileno. Alternativas:
#   es-CL-CatalinaNeural   (femenina, Chile)
#   es-ES-AlvaroNeural     (masculino, España)
#   es-MX-JorgeNeural      (masculino, México)
#   es-AR-TomasNeural      (masculino, Argentina)
# Lista completa: edge-tts --list-voices | grep es-
TTS_VOICE=es-CL-LorenzoNeural
